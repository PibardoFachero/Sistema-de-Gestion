        {
            "parameters": {
                "schemaType": "manual",
                "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"reply\": {\n      \"type\": \"string\",\n      \"description\": \"Respuesta conversacional para el estudiante, en español.\"\n    },\n    \"tasks\": {\n      \"type\": \"array\",\n      \"description\": \"Lista de tareas planificadas. Vacía si no se pidió planificar.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"description\": {\n            \"type\": \"string\"\n          },\n          \"due_date\": {\n            \"type\": \"string\",\n            \"description\": \"Formato YYYY-MM-DD\"\n          },\n          \"duration_minutes\": {\n            \"type\": \"integer\"\n          },\n          \"priority\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"low\",\n              \"medium\",\n              \"high\"\n            ]\n          }\n        },\n        \"required\": [\n          \"title\",\n          \"description\",\n          \"due_date\",\n          \"duration_minutes\",\n          \"priority\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"reply\",\n    \"tasks\"\n  ]\n}",
                "autoFix": true
            },
